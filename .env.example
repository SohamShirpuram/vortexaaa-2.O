# GovFix - Environment Configuration Example
# Copy this to .env or set environment variables in your system

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL 8)
# If DB_URL is not set or MySQL is unavailable, GovFix automatically falls back to persistent H2 (MySQL Mode)
DB_URL=jdbc:mysql://localhost:3306/govfix?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Optional Gemini AI API Key for enhanced category recommendation (fallback rules operate if unset)
GEMINI_API_KEY=
